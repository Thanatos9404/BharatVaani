# Flask Configuration
FLASK_SECRET_KEY="your_strong_random_secret_key_here_change_this"
FLASK_APP_BASE_URL="http://localhost:5000"

# Google OAuth 2.0 Credentials
# Get these from: https://console.cloud.google.com/
GOOGLE_CLIENT_ID="your_google_client_id_here.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_client_secret_here"
REDIRECT_URI="http://localhost:5000/oauth2callback"

# API Keys
# NewsAPI: https://newsapi.org/
NEWS_API_KEY="your_newsapi_key_here"

# Google Gemini API: https://makersuite.google.com/app/apikey
GEMINI_API_KEY="your_gemini_api_key_here"

# Hugging Face API (Optional - for What-If scenarios fallback): https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY="your_huggingface_api_key_here_optional"

# Note: Copy this file to .env and fill in your actual credentials
# Never commit .env to version control!
